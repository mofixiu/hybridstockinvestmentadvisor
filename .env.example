# Required API/database configuration
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/hybstockadvisor
JWT_SECRET_KEY=replace-with-at-least-32-random-characters

# Optional AI assistant; without a key the market-data API still runs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Investo NGX daily-data API. The free tier is for personal/evaluation use.
# Keep this key on the backend; the API limits market data to this owner email.
INVESTO_API=
INVESTO_PERSONAL_OWNER_EMAIL=
# Comma-separated account emails allowed to register; does not grant Investo data access.
INVITED_USER_EMAILS=

# Optional official NGX API. Configure the approval flag only after confirming
# that your agreement permits this use.
NGX_DATA_API_TOKEN=
NGX_MARKET_DATA_USE_APPROVED=false

# Password reset email (required before password reset can send codes)
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Optional, comma-separated browser origins for Flutter Web.
CORS_ALLOW_ORIGINS=
